# =============================================================================
# Application
# =============================================================================

APP_NAME=aircraft-server
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
APP_LOG_LEVEL=debug

# Common Rust logging format:
# error | warn | info | debug | trace
RUST_LOG=aircraft_server=debug,tower_http=debug,sqlx=debug


# =============================================================================
# Database
# =============================================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aircraft
POSTGRES_USER=aircraft_app
POSTGRES_PASSWORD=change_me

# Standard PostgreSQL connection URL.
DATABASE_URL=postgres://aircraft_app:change_me@localhost:5432/aircraft

# Optional migration database URL.
# Use a dedicated, sufficiently privileged migration role in production.
# Direct Just recipes prefer this value and fall back to DATABASE_URL.
MIGRATION_DATABASE_URL=postgres://aircraft_app:change_me@localhost:5432/aircraft


# =============================================================================
# Database Migration / Seeding
# =============================================================================

DATABASE_MIGRATIONS_DIR=database/migrations
DATABASE_SEEDS_DIR=database/seeds
DATABASE_VALIDATION_DIR=database/validation
DATABASE_STAGING_DIR=database/staging

RUN_MIGRATIONS_ON_STARTUP=false
RUN_SEEDS_ON_STARTUP=false


# =============================================================================
# Server Security
# =============================================================================

# Use a long random value in real environments.
JWT_SECRET=replace_with_long_random_secret

# Comma-separated list.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173


# =============================================================================
# Rate Limits / Timeouts
# =============================================================================

REQUEST_TIMEOUT_SECONDS=30
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_REQUESTS_PER_MINUTE=120


# =============================================================================
# External Services
# =============================================================================

# Leave blank locally unless needed.
OPENAI_API_KEY=
SENTRY_DSN=