# =============================================================================
# Copy to `.env` (gitignored) and adjust. These are local-development defaults,
# not production credentials.
# =============================================================================
#
# Read by `just` (justfile:4 `set dotenv-load`), by docker compose, and by the
# Rust binaries through `aircraft_config`. Two loading rules matter:
#
#   1. LAST DEFINITION WINS. A key defined twice silently takes its final value,
#      so a duplicate is an override, not a harmless leftover.
#   2. `$` EXPANDS in an unquoted value: `pa$$w0rd` does not survive the load.
#      Single-quote any value containing `$` to keep it literal.
#
# Only these are read by anything; a variable outside them is inert:
#   APP__*      -> aircraft_config (prefix `APP`, `__` nesting)
#   POSTGRES_*  -> docker-compose.yml and the justfile
#   DATABASE_URL / MIGRATION_DATABASE_URL / *_ROLE_PASSWORD -> justfile recipes
#   RUST_LOG    -> aircraft_observability


# =============================================================================
# Local PostgreSQL container (docker-compose.yml)
# =============================================================================

POSTGRES_IMAGE=postgres:17.10-trixie
POSTGRES_DB=aircraft
POSTGRES_USER=aircraft_app
POSTGRES_PASSWORD=change_me

# Host port, then container port. docker-compose.yml reads both.
POSTGRES_PORT=5432
POSTGRES_CONTAINER_PORT=5432


# =============================================================================
# Connection URLs (Just recipes, psql)
# =============================================================================

# Standard PostgreSQL connection URL, read by the Just recipes and psql.
# Percent-encode any reserved character in the password -- `&` as `%26`, `$` as
# `%24`. libpq and the `url` crate decode it back.
DATABASE_URL=postgres://aircraft_app:change_me@localhost:5432/aircraft

# Migration database URL. Use a dedicated, sufficiently privileged migration
# role in production. Direct Just recipes prefer this value and fall back to
# DATABASE_URL.
MIGRATION_DATABASE_URL=postgres://aircraft_app:change_me@localhost:5432/aircraft


# =============================================================================
# aircraft-server runtime
# =============================================================================

# HTTP runtime for `aircraft-server`. Both have defaults (127.0.0.1:8080), so
# these are only needed to override them. Binding 0.0.0.0 exposes the process on
# every interface and should be a deliberate deployment choice. The port must be
# 1-65535; zero is rejected while configuration loads.
APP__HTTP__HOST=127.0.0.1
APP__HTTP__PORT=8080
# How long shutdown waits for in-flight requests after SIGINT or SIGTERM before
# cancelling them. Defaults to 30 seconds. Zero is accepted and means cancel
# immediately; keep it below the orchestrator's termination grace period, or the
# platform escalates to SIGKILL first and the drain never finishes.
APP__HTTP__SHUTDOWN_GRACE_SECONDS=30

# The same connection as typed configuration for `aircraft-server`. Required by
# `DatabaseSettings::load()`, which rejects a blank value, a string that does not
# parse as a URL, a scheme other than postgres:// or postgresql://, and a URL
# naming neither a host nor a database.
#
# This names the restricted runtime role, not the owner above: the server must
# not be able to create schemas, extensions, tables, or roles in the database it
# reads. Create the role with `just db-create-app-role` and grant it with
# `just db-grant-app-role`.
APP__DATABASE__URL=postgres://aircraft_api_app:change_me@localhost:5432/aircraft
# Password for the local server role, read by `just db-create-app-role`.
# Keep it identical to the password in APP__DATABASE__URL above.
API_ROLE_PASSWORD=change_me
# Pool bounds for `aircraft-server`. All three have defaults (10, 5, 30), so
# these are only needed to override them, and each must be greater than zero.
# The statement timeout is applied to every pooled session, alongside an empty
# search_path that requires the server's SQL to be schema-qualified.
APP__DATABASE__MAX_CONNECTIONS=10
APP__DATABASE__ACQUIRE_TIMEOUT_SECONDS=5
APP__DATABASE__STATEMENT_TIMEOUT_SECONDS=30


# =============================================================================
# aircraft-ingest runtime
# =============================================================================

# Dedicated Rust ingestion adapter. In Aiven, use a restricted ingestion role
# and require certificate verification in this URL.
APP__INGEST__DATABASE_URL=postgres://aircraft_ingest_app:change_me@localhost:5432/aircraft
# Password for the local ingestion role, read by `just db-create-ingest-role`.
# Keep it identical to the password in APP__INGEST__DATABASE_URL above.
INGEST_ROLE_PASSWORD=change_me
APP__INGEST__MAX_INPUT_BYTES=536870912
APP__INGEST__LOCK_TIMEOUT_SECONDS=5
APP__INGEST__STATEMENT_TIMEOUT_SECONDS=1800
# Empty uses the operating system's secure temporary directory.
# APP__INGEST__TEMP_DIR=/var/tmp/aircraft-ingest
APP__INGEST__MAX_CONNECTIONS=5


# =============================================================================
# Logging
# =============================================================================

# Common Rust logging format:
# error | warn | info | debug | trace
# Setting this replaces `aircraft-server`'s built-in default outright rather
# than adding to it: `EnvFilter` applies its own default only when no directive
# parses at all, and a target matching none of the directives below is not
# logged at all. A bare level must therefore lead the list, or the per-target
# entries here would silence every crate they do not name -- including
# `aircraft_api`, which emits one `request completed` event per request.
# `the_documented_log_filter_still_admits_request_tracing` in
# apps/server/tests/health.rs reads this line back and proves it.
#
# That leading level is `error` and not `info` deliberately. It is the floor for
# every crate not named after it, and dependencies log at their own discretion:
# `sqlx` reports an unrecognized connect parameter at WARN *with its value*, and
# does not recognize `sslpassword`, so a leading `info` publishes that
# credential out of the database URL. Raise a dependency by naming it here, not
# by raising the floor. `no_connect_parameter_reaches_the_log` proves it.
RUST_LOG=error,aircraft_server=debug,aircraft_api=debug,aircraft_app=debug,aircraft_db=debug,aircraft_ingest=debug


# =============================================================================
# Not read by any code yet
# =============================================================================
#
# Kept commented as the intended spelling for settings whose consumers are not
# implemented -- AGENTS.md records that the limit and CORS settings "land with
# their consumers". Uncommenting them today changes no behaviour; they are here
# so the names are not reinvented when those consumers arrive.
#
# JWT_SECRET=replace_with_long_random_secret
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# REQUEST_TIMEOUT_SECONDS=30
# MAX_REQUEST_BODY_BYTES=1048576
# RATE_LIMIT_REQUESTS_PER_MINUTE=120
# OPENAI_API_KEY=
# SENTRY_DSN=
