# =============================================================================
# Rust
# =============================================================================

# Build artifacts
/target/
**/target/

# Cargo lockfile
# Keep Cargo.lock for applications/servers.
# Ignore it only for reusable library crates.
/# Cargo.lock

# Backup files generated by rustfmt
**/*.rs.bk

# Profiling / coverage
*.profraw
*.profdata
coverage/
coverage-*/
tarpaulin-report.html
cobertura.xml
lcov.info

# Criterion benchmarks
/criterion/
**/criterion/


# =============================================================================
# Environment / secrets
# =============================================================================

.env
.env.*
!.env.example
!.env.sample

*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
.secret/
.local-secrets/


# =============================================================================
# Logs
# =============================================================================

*.log
logs/
log/


# =============================================================================
# Database
# =============================================================================

# Keep schema, migrations, seeds, and validation SQL tracked.
!database/
!database/migrations/
!database/seeds/
!database/validation/
!database/**/*.sql
!database/**/*.md
!database/**/*.json.example

# Raw source datasets are local/private; only sanitized examples are tracked.
database/staging/*.json
!database/staging/*.json.example

# Ignore generated/local database files
database/data/
database/tmp/
database/temp/
database/cache/
database/backups/
database/dumps/
database/exports/
database/imports/
database/generated/

# Local database runtime files
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# PostgreSQL dumps / backups
*.dump
*.backup
*.bak
*.sql.gz
*.sql.zip
*.psql
*.pgdump

# Local Docker database volumes
postgres-data/
pgdata/
database/postgres-data/
database/pgdata/


# =============================================================================
# Docker / local infrastructure
# =============================================================================

docker-compose.override.yml
docker-compose.local.yml
compose.override.yml


# =============================================================================
# IDEs / editors
# =============================================================================

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db


# =============================================================================
# OS / tooling
# =============================================================================

.cache/
tmp/
temp/

# Node tooling, if used for docs/admin scripts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.env

# Local agent/review tooling (CodeRabbit CLI installs skill packs into the repo)
.agents/
.aider-desk/
skills-lock.json
